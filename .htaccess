# saakyan.ai: Serverregeln für Hostinger (LiteSpeed, Apache-kompatibel)
# Liegt im Wurzelverzeichnis (public_html). Vor dem ersten Einsatz eine
# vorhandene .htaccess aus dem Dateimanager sichern und deren Regeln prüfen.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1) Ein Host, ein Protokoll: www, http und fremde Hosts per 301 auf https://saakyan.ai
RewriteCond %{HTTP_HOST} !^saakyan\.ai$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://saakyan.ai%{REQUEST_URI} [R=301,L,NE]

# 2) Arbeitsdateien nie ausliefern (README.md liegt noch vom alten Stand auf dem Server)
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(md|bak|log|zip)$ - [F,L]

# 3) /index.html auf / (nur bei direktem Aufruf, sonst Schleife über DirectoryIndex)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://saakyan.ai/%1 [R=301,L,NE]

# 4) Doppelte Schrägstriche zusammenfassen (//leistungen.html)
RewriteCond %{THE_REQUEST} \s[^?\s]*//
RewriteRule ^(.*)$ https://saakyan.ai/$1 [R=301,L,NE]

# 5) Schrägstrich hinter .html entfernen (/leistungen.html/)
RewriteRule ^(.+\.html)/+$ https://saakyan.ai/$1 [R=301,L,NE]

# 6) URL ohne Endung auf die .html-Adresse (/leistungen, /leistungen/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ https://saakyan.ai/$1.html [R=301,L,NE]
</IfModule>

# Zeichensatz und Typen
AddDefaultCharset utf-8
AddCharset utf-8 .html .css .js .txt .xml .svg .json
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# Zwischenspeicher
# HTML: immer beim Server nachfragen (Änderungen sofort sichtbar).
# CSS/JS: 7 Tage wie bisher, Wechsel nur über ?v= im Link.
# Schriften: 1 Jahr, Dateinamen ändern sich bei neuer Schrift.
# Bilder: 30 Tage.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|avif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Kompression: Hostinger liefert bereits Brotli/Gzip aus. Nur Rückfall.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/x-javascript image/svg+xml application/ld+json
</IfModule>

# Sicherheits-Header
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # CSP: erlaubt nur eigene Dateien, Botpoison-API und Formspark.
  # Der Hash gehört zum Inline-Skript document.documentElement.classList.add('js'); bei Änderung neu berechnen:
  # printf '%s' "document.documentElement.classList.add('js')" | openssl dgst -sha256 -binary | base64
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.botpoison.com https://submit-form.com; form-action 'self' https://submit-form.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
